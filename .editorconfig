root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
# RS0030 — a use of a symbol listed in BannedSymbols.txt (repo root). ERROR, not warning: the
# bans encode ownership invariants ("WorkspaceMembers is reachable only through
# IWorkspaceMembershipService"), and a warning is a suggestion. An owner opts back in with a
# narrow `#pragma warning disable RS0030` carrying the reason it is the exception.
dotnet_diagnostic.RS0030.severity = error

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_style = space
indent_size = 2

# resharper-clt-suppression-via-annotations: these MCP wire-contract DTOs are constructed by
# System.Text.Json deserialization / the MCP SDK's reflection-based tool-result marshalling, not
# by any call ReSharper's static graph can see — the analyzer is BLIND here, not merely told to
# stay quiet. NotAccessedPositionalProperty.Global fires on every positional-record property that
# no local code reads back (the wire consumer is a remote MCP client), and
# UnusedAutoPropertyAccessor.Global fires the same way on ordinary auto-properties. Confirmed live
# with `jb inspectcode 2026.2`: 330 + 70 = 400 findings under this glob, 0 elsewhere in the
# solution touched. rule x subtree granularity, honored by both jb and Rider, higher priority than
# PetBox.slnx.DotSettings — see the doctrine note atop scripts/inspect-gate.cs for why every
# resharper-severity key lives HERE and never in a nested/per-project editorconfig or DotSettings.
[src/PetBox.Web/Mcp/Contract/*.cs]
resharper_not_accessed_positional_property_global_highlighting = none
resharper_unused_auto_property_accessor_global_highlighting = none

# resharper-clt-step5c-tests-project-narrowing: xUnit constructs IClassFixture<T>/
# ICollectionFixture<T> fixture classes via reflection at test-run time — no call site in source
# ever names the type directly, so ClassNeverInstantiated.Global is structurally blind to this
# whole category, not just noisy about it (worked example:
# tests/PetBox.Tests/Web/AdminProjectDetailAuthzTests.cs — AdminProjectDetailAuthzFixture flagged
# unused at its declaration on line 17 while IClassFixture<AdminProjectDetailAuthzFixture> uses it
# on line 69 of the same file). Confirmed: 79 of the 101 ClassNeverInstantiated.Global findings
# under tests/** are exactly this shape; the remaining ~22 were triaged and handled elsewhere
# (resharper-clt-step5c-tests-project-narrowing), not swept in by this glob.
[tests/**.cs]
resharper_class_never_instantiated_global_highlighting = none

# resharper-clt-step5b-dto-contract-and-minimal-api: wire DTOs/records under */Contract/*.cs across
# every assembly (PetBox.Core, PetBox.Tasks, PetBox.Log.Core, PetBox.Memory, PetBox.Sessions,
# PetBox.Data, PetBox.Deploy, PetBox.Web, ...) are populated by JSON deserialization / linq2db
# mapping / a remote REST-adjacent client reading a positional property back, never by a `new` call
# this analyzer's static graph can see — the same blindness as the MCP-contract glob above, at a
# wider scope. PetBox.Core/Models/*.cs joins the same section for the same reason one layer down:
# these are the linq2db FluentMappingBuilder entities themselves (AGENTS.md "A Core entity column
# must be declared in PetBoxDb's Fluent mapping") — populated by a SELECT hydrating the mapped
# properties, never by a `new` + property-set the analyzer's graph can trace either. Restricted to
# the two PROPERTY-shaped rules only: NotAccessedPositionalProperty and UnusedAutoPropertyAccessor
# can only ever fire on a record/auto-property member, never on an interface method or a helper
# class, so this glob is safe even in the several Contract/*.cs files that also hold a service
# interface (ITasksService.cs, ILogService.cs, ISessionService.cs, ...) or a small companion
# exception/factory type alongside their DTOs, and in the Models/*.cs files that hold a small static
# helper (HealthTags.cs, TaskBoardMeta.cs) alongside their entities — verified file-by-file before
# adding this section. MemberCanBePrivate.Global / UnusedMember.Global / ClassNeverInstantiated.Global
# are deliberately NOT included here: those three rule shapes did catch genuinely dead members living
# in these same Contract files — ITasksService.ResolveKindAsync/DeleteMethodologyAsync (both:
# declared + implemented, zero callers anywhere), ILogService.QueryAsync (a delegating wrapper
# nobody called — every real caller injects ILogQueryService directly), DeniedPragmaException
# .PragmaName (adapters read .Message, never .PragmaName), and two of three LogSchemaMissingException
# constructors (only the 2-arg ctor is ever thrown) — all REMOVED as dead code, not suppressed. A
# blanket glob on those three rules would have hidden every one of them.
[{src/**/Contract/*.cs,src/PetBox.Core/Models/*.cs}]
resharper_not_accessed_positional_property_global_highlighting = none
resharper_unused_auto_property_accessor_global_highlighting = none
