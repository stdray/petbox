@page "/ui/{workspaceKey}/{projectKey}/memory/{store}"
@using PetBox.Web.Memory
@model PetBox.Web.Pages.ProjectHome.MemoryStoreModel
@{
	ViewData["Title"] = $"{Model.Store} — Memory";

	// The "next" link for BOTH modes' keyset cursor (spec listing-tail-reachable / result-set-pageable):
	// carries every control that's part of the fingerprint (q/type/scope/sort) plus the new cursor.
	// There is no "prev" link by design: a keyset cursor only names how to resume FORWARD; each "next"
	// click lands on its own bookmarkable URL, so the browser's own Back does what a "prev" button would.
	//
	// ui-search-page-position-and-size: ALSO carries `size` (the CURRENT page size, so paging forward
	// never silently reverts to the default) and `pos` (rows already delivered — RangeTo IS that count,
	// since this page's range ends exactly where the next page's position counter should start).
	// Neither is part of the cursor's own fingerprint (KeysetCursor.cs:38-40) — they ride alongside it
	// as plain presentation/shape parameters, same as q/type/scope/sort already do here.
	string NextHref(string cursor)
	{
		var href = $"{Routes.ProjectMemoryStore(Model.WorkspaceKey, Model.ProjectKey, Model.Store)}?cursor={Uri.EscapeDataString(cursor)}";
		if (!string.IsNullOrWhiteSpace(Model.Query)) href += $"&q={Uri.EscapeDataString(Model.Query)}";
		if (!string.IsNullOrWhiteSpace(Model.Type)) href += $"&type={Uri.EscapeDataString(Model.Type)}";
		if (!string.IsNullOrWhiteSpace(Model.Scope)) href += $"&scope={Uri.EscapeDataString(Model.Scope)}";
		if (!string.IsNullOrWhiteSpace(Model.Sort)) href += $"&sort={Uri.EscapeDataString(Model.Sort)}";
		href += $"&size={Model.EffectiveSize}&pos={Model.RangeTo}";
		return href;
	}

	string? HitHref(MemorySearchScope.Row hit) => hit.Scope == "workspace"
		? MemoryLinks.WorkspaceEntry(Model.WorkspaceKey, hit.Store, hit.Entry.Key)
		: MemoryLinks.ProjectEntry(Model.WorkspaceKey, Model.ProjectKey, hit.Store, hit.Entry.Key);
}

<div class="mb-4 flex items-baseline gap-3 flex-wrap">
	<a href="@Routes.ProjectMemory(Model.WorkspaceKey, Model.ProjectKey)" class="link link-hover opacity-70" data-testid="store-breadcrumb">memory</a>
	<span class="opacity-40">/</span>
	<h1 class="text-2xl font-semibold font-mono" data-testid="store-title">@Model.Store</h1>
	<span class="badge badge-ghost" data-testid="store-total">@Model.Total entr@(Model.Total == 1 ? "y" : "ies")</span>
</div>

@if (Model.Aggregate is { TotalEntries: > 0 } agg)
{
	<div class="stats stats-horizontal shadow bg-base-200 border border-base-300 mb-4 overflow-x-auto" data-testid="usage-aggregate">
		<div class="stat py-2 px-4">
			<div class="stat-title text-xs">Surfaced</div>
			<div class="stat-value text-lg" data-testid="agg-surfaced">@agg.SurfacedAtLeastOnce / @agg.TotalEntries</div>
			<div class="stat-desc">@($"{agg.SurfacedFraction:P0}") ever returned in search</div>
		</div>
		<div class="stat py-2 px-4">
			<div class="stat-title text-xs">Opened</div>
			<div class="stat-value text-lg" data-testid="agg-opened">@agg.OpenedAtLeastOnce / @agg.TotalEntries</div>
			<div class="stat-desc">@($"{agg.OpenedFraction:P0}") opened directly — a read count, not a value verdict; see Cost/Fit</div>
		</div>
		<div class="stat py-2 px-4">
			<div class="stat-title text-xs">Median recency</div>
			<div class="stat-value text-lg" data-testid="agg-recency">
				@(agg.MedianLastHitAt is { } m ? $"{(int)Math.Max(0, (DateTime.UtcNow - m).TotalDays)}d" : "—")
			</div>
			<div class="stat-desc">of the surfaced set</div>
		</div>
		<div class="stat py-2 px-4">
			<div class="stat-title text-xs">Dead tail</div>
			<div class="stat-value text-lg" data-testid="agg-dead">@agg.DeadTail.Count</div>
			<div class="stat-desc" title="@string.Join(", ", agg.DeadTail.TopKeys)">never surfaced</div>
		</div>
		<div class="stat py-2 px-4">
			<div class="stat-title text-xs">Cost (@(agg.Cost.WindowDays)d)</div>
			<div class="stat-value text-lg" data-testid="agg-cost">
				@(agg.Cost.Deliveries > 0 ? agg.Cost.DeliveredChars.ToString("N0") : "—")
			</div>
			<div class="stat-desc"
				title="body chars this store delivered into callers' context over the window — read together with Fit: high chars + low fit = noise-boar, low chars + high fit = precise index">
				@(agg.Cost.Deliveries > 0 ? $"{agg.Cost.EntriesDelivered} entries · {agg.Cost.Deliveries} deliveries" : "no deliveries in window")
			</div>
		</div>
		<div class="stat py-2 px-4">
			<div class="stat-title text-xs">Fit</div>
			<div class="stat-value text-lg" data-testid="agg-fit">
				@(agg.Cost.AvgKRel is { } fit ? $"{fit:P0}" : "—")
			</div>
			<div class="stat-desc"
				title="mean within-request relevance of delivered rows — read together with Cost: high chars + low fit = noise-boar, low chars + high fit = precise index">
				@(agg.Cost.AvgKRel.HasValue ? "avg relevance of delivered rows" : "no fit measured in window")
			</div>
		</div>
	</div>
}

<form method="get" class="mb-4 flex flex-wrap items-center gap-2" data-testid="store-search-form">
	<partial name="_SearchQueryBox" model='new SearchQueryBoxModel(Model.Query, "Search key, description, body or tags — hybrid (lexical + semantic)…", "store-search-input", CssClass: "input input-bordered input-sm flex-1 max-w-md")' />
	<select name="type" class="select select-bordered select-sm" data-testid="store-search-type">
		<option value="" selected="@(string.IsNullOrEmpty(Model.Type))">Any type</option>
		@foreach (var t in new[] { "User", "Feedback", "Project", "Reference" })
		{
			<option value="@t" selected="@(string.Equals(Model.Type, t, StringComparison.OrdinalIgnoreCase))">@t</option>
		}
	</select>
	@if (Model.ScopeSelectable)
	{
		<select name="scope" class="select select-bordered select-sm" data-testid="store-search-scope">
			<option value="project" selected="@(string.IsNullOrEmpty(Model.Scope) || Model.Scope == "project")">This project</option>
			<option value="workspace" selected="@(Model.Scope == "workspace")">Workspace</option>
			<option value="cascade" selected="@(Model.Scope == "cascade")">Project + workspace</option>
		</select>
	}
	<select name="sort" class="select select-bordered select-sm" data-testid="store-search-sort">
		<option value="relevance" selected="@(string.IsNullOrEmpty(Model.Sort) || Model.Sort == "relevance")">Relevance</option>
		<option value="updated" selected="@(Model.Sort == "updated")">Updated</option>
		<option value="created" selected="@(Model.Sort == "created")">Created</option>
	</select>
	@* ui-search-page-position-and-size: page size lives in the FILTER form on purpose (a plain GET
	   with no cursor/pos hidden field) — changing it always starts the walk over rather than trying
	   to reconcile a keyset position against a different page shape. *@
	<partial name="_SearchPageSizeSelect" model='new SearchPageSizeSelectModel(Model.EffectiveSize, "store-search-size")' />
	<button type="submit" class="btn btn-sm btn-primary" data-testid="store-search-submit">Search</button>
	@if (!string.IsNullOrWhiteSpace(Model.Query))
	{
		<a href="@Routes.ProjectMemoryStore(Model.WorkspaceKey, Model.ProjectKey, Model.Store)" class="btn btn-sm btn-ghost" data-testid="store-search-clear">Clear</a>
	}
</form>

@if (Model.CursorError is { } cursorError)
{
	@* Shared by both modes now (spec result-set-pageable): a stale/foreign cursor is a LOUD refusal
	   (KeysetCursor's own contract), never a silent restart — this restarts the walk from the top
	   instead of surfacing that as a raw error, in listing OR query mode. *@
	<partial name="_SearchNotice" model='new SearchNoticeModel("store-cursor-error", cursorError, CssClass: "mb-2")' />
}

@if (Model.IsSearch && Model.Stop == "pool-boundary" && Model.PoolBoundaryHint is { } poolHint)
{
	@* card requirement 2: pool-boundary MUST read as "ranking depth reached, narrow the query" — never
	   as a quiet end of the list. This is the human-readable twin of memory_search's own hint. *@
	<partial name="_SearchNotice" model='new SearchNoticeModel("store-search-pool-boundary", poolHint, CssClass: "mb-2")' />
}

@if (Model.IsSearch && Model.Retrievers is { } retr)
{
	<div class="text-xs opacity-60 mb-2" data-testid="store-search-retrievers">
		retrievers: @(retr.Lexical ? "lexical" : null) @(retr.Semantic ? "semantic" : null)
		@(retr.Degraded ? $"(degraded: {retr.DegradedReason})" : null)
	</div>
	@* ui-search-ranking-mode-preference: the honest three-way ranking outcome (Reranked /
	   DegradedRrf / ChosenRrf) the preference toggle actually changes — see BrowserState.SearchRankingMode. *@
	@if (retr.Ranking is { } ranking)
	{
		<div class="text-xs opacity-60 mb-2" data-testid="store-search-ranking">ranking: @ranking</div>
	}
}

@if (Model.IsSearch)
{
	@if (Model.Hits.Count == 0)
	{
		<div class="alert" data-testid="store-empty">No entries match this search.</div>
	}
	else
	{
		<ul class="flex flex-col gap-2" data-testid="store-hits">
			@foreach (var hit in Model.Hits)
			{
				var u = Model.HitUsage.TryGetValue(MemorySearchScope.UsageKey(hit.Scope, hit.Store, hit.Entry.Key), out var uv) ? uv : null;
				<li class="memory-entry card bg-base-200 border border-base-300" data-testid="memory-hit" data-entry-key="@hit.Entry.Key">
					<div class="card-body p-3">
						<div class="flex items-baseline justify-between gap-2 flex-wrap">
							<a href="@(HitHref(hit) ?? "#")" class="font-mono font-semibold link link-hover">@hit.Entry.Key</a>
							<span class="badge badge-outline badge-sm" data-testid="hit-scope">@hit.Scope</span>
							<span class="badge badge-ghost badge-sm" data-testid="hit-score" title="fused relevance">score @hit.Score.ToString("0.000")</span>
							@if (hit.Retriever is not null)
							{
								<span class="badge badge-ghost badge-sm" data-testid="hit-retriever">@hit.Retriever</span>
							}
							@if (u is not null)
							{
								<span class="badge badge-ghost badge-sm opacity-70" data-testid="entry-usage"
									title="surfaced @u.Surfaced x / opened @u.Opened x / last @(u.LastHitAt?.ToString("yyyy-MM-dd HH:mm") ?? "none") -- an impression count, not a value verdict">
									👁 @u.Surfaced · 📖 @u.Opened
								</span>
								<span class="badge badge-ghost badge-sm opacity-70" data-testid="entry-cost"
									title="body chars delivered across this entry's deliveries -- a fact, not a verdict on its own; read together with Fit">
									💰 @(u.Deliveries > 0 ? u.DeliveredChars.ToString("N0") : "—")
								</span>
								<span class="badge badge-ghost badge-sm opacity-70" data-testid="entry-fit"
									title="mean within-request fit (kRel) of delivered rows -- pairs with Cost: high cost + low fit = noise, low cost + high fit = precise">
									🎯 @(u.AvgKRel is { } k ? $"{k:P0}" : "—")
								</span>
							}
							@if (hit.Entry.Tags.Count > 0)
							{
								<span class="flex gap-1 flex-wrap">
									@foreach (var tag in hit.Entry.Tags)
									{
										<span class="badge badge-ghost badge-sm" data-testid="entry-tag">@tag</span>
									}
								</span>
							}
						</div>
						@if (!string.IsNullOrEmpty(hit.Entry.Description))
						{
							<p class="text-sm opacity-70">@hit.Entry.Description</p>
						}
						@if (!string.IsNullOrEmpty(hit.Entry.Body))
						{
							<p class="text-sm opacity-90 whitespace-pre-wrap">@hit.Entry.Body</p>
						}
					</div>
				</li>
			}
		</ul>
		<div class="flex items-center justify-between mt-4 text-sm">
			<span class="opacity-60" data-testid="store-search-info">
				rows @Model.RangeFrom-@Model.RangeTo, ranked by relevance
				@(Model.Stop switch
				{
					"exhausted" => "— end of the match set.",
					"pool-boundary" => "— ranking depth reached, see above.",
					_ => "",
				})
			</span>
			<div class="join">
				@if (Model.HasNext && Model.NextCursor is { } searchNextCursor)
				{
					<a href="@NextHref(searchNextCursor)" class="btn btn-sm join-item" data-testid="store-search-next">Next ›</a>
				}
				else
				{
					<button class="btn btn-sm join-item btn-disabled" disabled data-testid="store-search-next-disabled">Next ›</button>
				}
			</div>
		</div>
	}
}
else if (Model.Entries.Count == 0)
{
	<div class="alert" data-testid="store-empty">This store has no active entries.</div>
}
else
{
	<ul class="flex flex-col gap-2" data-testid="store-entries">
		@foreach (var e in Model.Entries)
		{
			@* id = the entry key: the anchor half of the stable entry URL
			   (…/memory/{store}?key={key}#{key}, MemoryLinks). The ?key= half already made the
			   SERVER render the page that holds this card (MemoryStoreModel.HighlightKey) — the
			   fragment only scrolls to it, and `.memory-entry:target` in app.css highlights it.
			   data-highlight marks the same card server-side, so the highlight (and the test that
			   asserts it) does not hang on `:target` alone. An unresolvable key highlights nothing;
			   the store page still renders. *@
			var eu = Model.HitUsage.TryGetValue(MemorySearchScope.UsageKey(e.Scope, e.Store, e.Entry.Key), out var euv) ? euv : null;
			<li id="@e.Entry.Key"
				class="memory-entry card bg-base-200 border @(e.Entry.Key == Model.HighlightKey ? "border-primary ring-2 ring-primary/40" : "border-base-300")"
				data-testid="memory-entry" data-entry-key="@e.Entry.Key"
				@(e.Entry.Key == Model.HighlightKey ? Html.Raw("data-highlight=\"true\"") : null)>
				<div class="card-body p-3">
					<div class="flex items-baseline justify-between gap-2 flex-wrap">
						<span class="font-mono font-semibold">@e.Entry.Key</span>
						@if (Model.ScopeSelectable)
						{
							<span class="badge badge-outline badge-sm" data-testid="entry-scope">@e.Scope</span>
						}
						@if (eu is not null)
						{
							<span class="badge badge-ghost badge-sm opacity-70" data-testid="entry-usage"
								title="surfaced @eu.Surfaced x / opened @eu.Opened x / last @(eu.LastHitAt?.ToString("yyyy-MM-dd HH:mm") ?? "none") -- an impression count, not a value verdict">
								👁 @eu.Surfaced · 📖 @eu.Opened
							</span>
							<span class="badge badge-ghost badge-sm opacity-70" data-testid="entry-cost"
								title="body chars delivered across this entry's deliveries -- a fact, not a verdict on its own; read together with Fit">
								💰 @(eu.Deliveries > 0 ? eu.DeliveredChars.ToString("N0") : "—")
							</span>
							<span class="badge badge-ghost badge-sm opacity-70" data-testid="entry-fit"
								title="mean within-request fit (kRel) of delivered rows -- pairs with Cost: high cost + low fit = noise, low cost + high fit = precise">
								🎯 @(eu.AvgKRel is { } ek ? $"{ek:P0}" : "—")
							</span>
						}
						@if (e.Entry.Tags.Count > 0)
						{
							<span class="flex gap-1 flex-wrap">
								@foreach (var tag in e.Entry.Tags)
								{
									<span class="badge badge-ghost badge-sm" data-testid="entry-tag">@tag</span>
								}
							</span>
						}
					</div>
					@if (!string.IsNullOrEmpty(e.Entry.Description))
					{
						<p class="text-sm opacity-70">@e.Entry.Description</p>
					}
					@if (!string.IsNullOrEmpty(e.Entry.Body))
					{
						<p class="text-sm opacity-90 whitespace-pre-wrap">@e.Entry.Body</p>
					}
				</div>
			</li>
		}
	</ul>

	<div class="flex items-center justify-between mt-4 text-sm">
		<span class="opacity-60" data-testid="store-page-info">rows @Model.RangeFrom-@Model.RangeTo of @Model.Total</span>
		<div class="join">
			@if (Model.HasNext && Model.NextCursor is { } nextCursor)
			{
				<a href="@NextHref(nextCursor)" class="btn btn-sm join-item" data-testid="store-next">Next ›</a>
			}
			else
			{
				<button class="btn btn-sm join-item btn-disabled" disabled>Next ›</button>
			}
		</div>
	</div>
}
