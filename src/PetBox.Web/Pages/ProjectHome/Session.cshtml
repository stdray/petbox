@page "/ui/{workspaceKey}/{projectKey}/sessions/{sessionId}"
@model PetBox.Web.Pages.ProjectHome.SessionModel
@{
	ViewData["Title"] = $"{Model.SessionId} — Session";
}

<div class="mb-4 flex items-baseline gap-3 flex-wrap">
	<a href="@Routes.ProjectSessions(Model.WorkspaceKey, Model.ProjectKey)" class="link link-hover opacity-70" data-testid="session-breadcrumb">sessions</a>
	<span class="opacity-40">/</span>
	<h1 class="text-2xl font-semibold font-mono truncate" data-testid="session-title">@Model.SessionId</h1>
	@if (Model.Session is not null)
	{
		<span class="badge badge-ghost" data-testid="session-agent">@Model.Session.Agent</span>
	}
</div>

@if (Model.Session is not null)
{
	@if (Model.IsWindowed)
	{
		@* The provenance-bridge landing spot from a session-search hit (card
		   ui-search-sessions-hybrid): the SAME window session_get {fromOrdinal} would return,
		   not just the session header — "view full session" is the one-click escape back to
		   the unwindowed page. *@
		<div class="alert alert-info mb-3 flex items-center justify-between" data-testid="session-windowed-banner">
			<span>Showing from message @Model.FromOrdinal onward.</span>
			<a href="@Routes.ProjectSession(Model.WorkspaceKey, Model.ProjectKey, Model.SessionId)" class="link link-hover" data-testid="session-view-full">view full session</a>
		</div>
	}
	@* Session content is a transcript, not authored markdown — do NOT run it through the shared
	   markdown renderer (_MdBody / IMarkdownRenderer): work `session-body-render-cleanup` reverted
	   that (observations `session-gfm-render-shipped-ahead-of-its-own-decision`,
	   `markdig-parses-80x-deeper-than-it-renders` — a real transcript, e.g. ANSI logs, can carry
	   unbalanced `[` that blows past Markdig's render nesting cap and 500s the page). Razor
	   escapes the `@Model.DisplayContent` expression itself, so this stays plain, safe text in a
	   <pre> — no @Html.Raw. *@
	<div data-testid="session-content">
		<pre class="session-body" data-testid="session-body">@Model.DisplayContent</pre>
	</div>
}
