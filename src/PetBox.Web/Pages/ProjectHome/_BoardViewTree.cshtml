@model PetBox.Web.Pages.ProjectHome.TaskBoardModel
@* Tree view mode (board-view-modes): the stored part_of tree, DFS-ordered — the historical
   default. One entry in BoardViewModeRegistry ("tree" -> this partial); TaskBoard.cshtml
   dispatches to it without knowing anything mode-specific. Client interactivity (collapse /
   filter / active-only / sort) is ts/board.ts, keyed off the data-* attrs _TaskNodeCard
   renders on each <li data-node-id>. *@
@{
	// live-verification finding (sticky-filter-hides-board-silently): the filter bar — and its
	// "waiting only" toggle — used to render ONLY in the non-empty branch below, so a filter that
	// narrowed the board to zero nodes (persisted from a PREVIOUS visit, per board-view-cross-
	// device, or just the honest result of the current query) left NOTHING on the page saying a
	// filter was even active. It renders here UNCONDITIONALLY now, before the empty check, so the
	// toggle's own state (_BoardFilterSort's data-decision-pending) is always the visible source of
	// truth regardless of how many nodes matched.
	var filterSortModel = new PetBox.Web.Pages.Shared.BoardFilterSortModel(Fields: Model.Fields, ViewMode: BoardViewModeNames.Tree, SortHint: "sort branches:", ActiveOnly: Model.ActiveOnly, SortBy: Model.SortBy, SortDesc: Model.SortDesc, DecisionPendingOnly: Model.DecisionPendingOnly);
}
<partial name="_BoardFilterSort" model="filterSortModel" />
@if (Model.Nodes.Count == 0)
{
	<div class="alert" data-testid="board-empty">@(Model.DecisionPendingOnly ? "No task nodes are waiting on your decision." : "This board has no active task nodes.")</div>
}
else
{
	// A node has children when some other node's part_of parent is its NodeId — only those
	// get a collapse caret. board-filters-server-state: visibility/collapse/sort are now resolved
	// SERVER-SIDE (Model.ActiveOnly/CollapsedNodeIds/IsHiddenByCollapse, Model.Nodes already in
	// sort order) — ts/board.ts still wires the SAME client interactivity for instant toggling, it
	// just no longer computes the INITIAL state from localStorage (see initBoardPage's header
	// comment).
	var parentIds = Model.Nodes.Where(x => x.ParentNodeId is not null).Select(x => x.ParentNodeId!).ToHashSet(StringComparer.Ordinal);
	@* data-sort-scope (board-sort): the DFS-flat <li> list IS the single reorder scope for this
	   pane — ts/board.ts walks it depth-first via each row's data-parent-id, so "sort" reorders
	   sibling branches in place without touching the part_of nesting (finding D11). *@
	<ul class="flex flex-col gap-2" data-testid="board-nodes" data-sort-scope>
		@foreach (var n in Model.Nodes)
		{
			var closed = Model.Runtime.IsTerminalStatus(Model.KindSlug, n.Status);
			// A closed node hides under "active only" — unless it still has open
			// descendants, in which case it stays so its children aren't orphaned.
			var keepVisible = !closed || Model.ClosedWithActiveDescendant.Contains(n.NodeId);
			var hasChildren = parentIds.Contains(n.NodeId);
			var hiddenByActive = Model.ActiveOnly && closed && !keepVisible;
			var hidden = hiddenByActive || Model.IsHiddenByCollapse(n.ParentNodeId);
			var collapsedSelf = Model.CollapsedNodeIds.Contains(n.NodeId);
			var commentCount = Model.CommentCounts.GetValueOrDefault(n.NodeId);
			<partial name="_TaskNodeCard" model="new PetBox.Web.Pages.ProjectHome.TaskBoardModel.TaskNodeCard(Model.WorkspaceKey, Model.ProjectKey, Model.Board, Model.Runtime, Model.KindSlug, n, n.Depth, closed, keepVisible, hasChildren, commentCount, Model.Fields, Model.CommitUrlTemplate, Model.NodeRefs, Model.MemoryRefs, hidden, collapsedSelf)" />
		}
	</ul>
}
