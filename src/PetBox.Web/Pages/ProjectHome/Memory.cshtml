@page "/ui/{workspaceKey}/{projectKey}/memory"
@using PetBox.Web.Memory
@model PetBox.Web.Pages.ProjectHome.MemoryModel
@{
	ViewData["Title"] = $"Memory — {Model.Project?.Name ?? Model.ProjectKey}";

	string? HitHref(MemorySearchScope.Row hit) => hit.Scope == "workspace"
		? MemoryLinks.WorkspaceEntry(Model.WorkspaceKey, hit.Store, hit.Entry.Key)
		: MemoryLinks.ProjectEntry(Model.WorkspaceKey, Model.ProjectKey, hit.Store, hit.Entry.Key);

	// The query pool's keyset "next" link (spec result-set-pageable) — carries every control that's
	// part of the fingerprint (q/type/scope/sort) plus the new cursor. No "prev": a keyset cursor only
	// resumes FORWARD, so each "next" click is its own bookmarkable URL and the browser's Back covers it.
	string NextHref(string cursor)
	{
		var href = $"{Routes.ProjectMemory(Model.WorkspaceKey, Model.ProjectKey)}?cursor={Uri.EscapeDataString(cursor)}";
		if (!string.IsNullOrWhiteSpace(Model.Query)) href += $"&q={Uri.EscapeDataString(Model.Query)}";
		if (!string.IsNullOrWhiteSpace(Model.Type)) href += $"&type={Uri.EscapeDataString(Model.Type)}";
		if (!string.IsNullOrWhiteSpace(Model.Scope)) href += $"&scope={Uri.EscapeDataString(Model.Scope)}";
		if (!string.IsNullOrWhiteSpace(Model.Sort)) href += $"&sort={Uri.EscapeDataString(Model.Sort)}";
		return href;
	}
}

@{
	// Knowledge stores are the curated/agent-facing memory; system stores (e.g.
	// session-digests) are machine plumbing — set apart below, not counted as knowledge.
	var knowledge = Model.Stores.Where(s => !s.IsSystem).ToList();
	var systemStores = Model.Stores.Where(s => s.IsSystem).ToList();
}

<div class="mb-4 flex items-baseline gap-3 flex-wrap">
	<h1 class="text-2xl font-semibold" data-testid="memory-title">@(Model.Project?.Name ?? Model.ProjectKey) · memory</h1>
	<span class="badge badge-ghost">@knowledge.Count</span>
</div>

@if (Model.Project is null)
{
	<div class="alert alert-error" data-testid="memory-notfound">Project not found.</div>
	return;
}

@if (!Model.MemoryEnabled)
{
	<div class="alert" data-testid="memory-disabled">The Memory module is disabled.</div>
	return;
}

@* Project-wide search (spec search-one-engine-for-human-and-agent): sweeps EVERY store in scope
   — the UI twin of memory_search called with no `store` arg. The per-store page can only ever
   narrow to the store it is already on, so this is the one place a query reaches across the
   whole project's (and optionally the workspace's) memory at once. *@
<form method="get" class="mb-4 flex flex-wrap items-center gap-2" data-testid="memory-search-form">
	<input type="search" name="q" value="@Model.Query" placeholder="Search across every store — hybrid (lexical + semantic)…"
		class="input input-bordered input-sm flex-1 max-w-md" data-testid="memory-search-input" />
	<select name="type" class="select select-bordered select-sm" data-testid="memory-search-type">
		<option value="" selected="@(string.IsNullOrEmpty(Model.Type))">Any type</option>
		@foreach (var t in new[] { "User", "Feedback", "Project", "Reference" })
		{
			<option value="@t" selected="@(string.Equals(Model.Type, t, StringComparison.OrdinalIgnoreCase))">@t</option>
		}
	</select>
	@if (Model.ScopeSelectable)
	{
		<select name="scope" class="select select-bordered select-sm" data-testid="memory-search-scope">
			<option value="project" selected="@(string.IsNullOrEmpty(Model.Scope) || Model.Scope == "project")">This project</option>
			<option value="workspace" selected="@(Model.Scope == "workspace")">Workspace</option>
			<option value="cascade" selected="@(Model.Scope == "cascade")">Project + workspace</option>
		</select>
	}
	<select name="sort" class="select select-bordered select-sm" data-testid="memory-search-sort">
		<option value="relevance" selected="@(string.IsNullOrEmpty(Model.Sort) || Model.Sort == "relevance")">Relevance</option>
		<option value="updated" selected="@(Model.Sort == "updated")">Updated</option>
		<option value="created" selected="@(Model.Sort == "created")">Created</option>
	</select>
	<button type="submit" class="btn btn-sm btn-primary" data-testid="memory-search-submit">Search</button>
	@if (!string.IsNullOrWhiteSpace(Model.Query))
	{
		<a href="@Routes.ProjectMemory(Model.WorkspaceKey, Model.ProjectKey)" class="btn btn-sm btn-ghost" data-testid="memory-search-clear">Clear</a>
	}
</form>

@if (Model.CursorError is { } cursorError)
{
	<div class="alert alert-warning mb-2" data-testid="memory-cursor-error">
		@cursorError
	</div>
}

@if (Model.IsSearch && Model.Stop == "pool-boundary" && Model.PoolBoundaryHint is { } poolHint)
{
	@* card requirement 2: pool-boundary MUST read as "ranking depth reached, narrow the query". *@
	<div class="alert alert-warning mb-2" data-testid="memory-search-pool-boundary">
		@poolHint
	</div>
}

@if (Model.IsSearch)
{
	@if (Model.Retrievers is { } retr)
	{
		<div class="text-xs opacity-60 mb-2" data-testid="memory-search-retrievers">
			retrievers: @(retr.Lexical ? "lexical" : null) @(retr.Semantic ? "semantic" : null)
			@(retr.Degraded ? $"(degraded: {retr.DegradedReason})" : null)
		</div>
	}
	@if (Model.Hits.Count == 0)
	{
		<div class="alert" data-testid="memory-search-empty">No entries match this search.</div>
	}
	else
	{
		<ul class="flex flex-col gap-2" data-testid="memory-search-hits">
			@foreach (var hit in Model.Hits)
			{
				var u = Model.HitUsage.TryGetValue(MemorySearchScope.UsageKey(hit.Scope, hit.Store, hit.Entry.Key), out var uv) ? uv : null;
				<li class="memory-entry card bg-base-200 border border-base-300" data-testid="memory-search-hit" data-entry-key="@hit.Entry.Key">
					<div class="card-body p-3">
						<div class="flex items-baseline justify-between gap-2 flex-wrap">
							<a href="@(HitHref(hit) ?? "#")" class="font-mono font-semibold link link-hover">@hit.Entry.Key</a>
							<span class="badge badge-outline badge-sm" data-testid="hit-scope">@hit.Scope</span>
							<span class="badge badge-outline badge-sm" data-testid="hit-store">@hit.Store</span>
							<span class="badge badge-ghost badge-sm" data-testid="hit-score" title="fused relevance">score @hit.Score.ToString("0.000")</span>
							@if (hit.Retriever is not null)
							{
								<span class="badge badge-ghost badge-sm" data-testid="hit-retriever">@hit.Retriever</span>
							}
							@if (u is not null)
							{
								<span class="badge badge-ghost badge-sm opacity-70" data-testid="entry-usage"
									title="surfaced @u.Surfaced x / opened @u.Opened x / last @(u.LastHitAt?.ToString("yyyy-MM-dd HH:mm") ?? "none") -- an impression count, not a value verdict">
									👁 @u.Surfaced · 📖 @u.Opened
								</span>
							}
							@if (hit.Entry.Tags.Count > 0)
							{
								<span class="flex gap-1 flex-wrap">
									@foreach (var tag in hit.Entry.Tags)
									{
										<span class="badge badge-ghost badge-sm" data-testid="entry-tag">@tag</span>
									}
								</span>
							}
						</div>
						@if (!string.IsNullOrEmpty(hit.Entry.Description))
						{
							<p class="text-sm opacity-70">@hit.Entry.Description</p>
						}
						@if (!string.IsNullOrEmpty(hit.Entry.Body))
						{
							<p class="text-sm opacity-90 whitespace-pre-wrap">@hit.Entry.Body</p>
						}
					</div>
				</li>
			}
		</ul>
		<div class="flex items-center justify-between mt-4 text-sm">
			<span class="opacity-60" data-testid="memory-search-info">
				@Model.Hits.Count result@(Model.Hits.Count == 1 ? "" : "s"), ranked by relevance
				@(Model.Stop switch
				{
					"exhausted" => "— end of the match set.",
					"pool-boundary" => "— ranking depth reached, see above.",
					_ => "",
				})
			</span>
			<div class="join">
				@if (Model.HasNext && Model.NextCursor is { } searchNextCursor)
				{
					<a href="@NextHref(searchNextCursor)" class="btn btn-sm join-item" data-testid="memory-search-next">Next ›</a>
				}
				else
				{
					<button class="btn btn-sm join-item btn-disabled" disabled data-testid="memory-search-next-disabled">Next ›</button>
				}
			</div>
		</div>
	}
}
else if (Model.Stores.Count == 0)
{
	<div class="alert" data-testid="memory-empty">No memory stores yet. Agents create them via the memory MCP tools.</div>
}
else
{
	@if (knowledge.Count == 0)
	{
		<div class="alert" data-testid="memory-empty-knowledge">No knowledge stores yet — only system stores exist. Agents create knowledge stores via the memory MCP tools.</div>
	}
	else
	{
		<section class="grid grid-cols-1 sm:grid-cols-2 gap-3" data-testid="memory-list">
			@foreach (var s in knowledge)
			{
				<a href="@Routes.ProjectMemoryStore(Model.WorkspaceKey, Model.ProjectKey, s.Name)"
					class="card bg-base-200 border border-base-300 hover:border-primary transition-colors"
					data-testid="store-card" data-store-name="@s.Name">
					<div class="card-body p-4">
						<span class="font-mono font-semibold">@s.Name</span>
						@if (!string.IsNullOrEmpty(s.Description))
						{
							<p class="text-sm opacity-80">@s.Description</p>
						}
						<div class="text-xs opacity-50 font-mono mt-2">updated @s.UpdatedAt.ToString("yyyy-MM-dd HH:mm") · created @s.CreatedAt.ToString("yyyy-MM-dd")</div>
					</div>
				</a>
			}
		</section>
	}

	@if (systemStores.Count > 0)
	{
		<section class="mt-8" data-testid="memory-system-list">
			<h2 class="text-xs font-semibold uppercase tracking-wide opacity-50 mb-2">System stores</h2>
			<p class="text-xs opacity-50 mb-3">Machine plumbing — excluded from the default memory search sweep, not project knowledge.</p>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
				@foreach (var s in systemStores)
				{
					<a href="@Routes.ProjectMemoryStore(Model.WorkspaceKey, Model.ProjectKey, s.Name)"
						class="card bg-base-200/50 border border-base-300 border-dashed hover:border-primary transition-colors opacity-70"
						data-testid="system-store-card" data-store-name="@s.Name">
						<div class="card-body p-4">
							<span class="font-mono font-semibold flex items-center gap-2">
								@s.Name
								<span class="badge badge-ghost badge-sm">system</span>
							</span>
							@if (!string.IsNullOrEmpty(s.Description))
							{
								<p class="text-sm opacity-80">@s.Description</p>
							}
							<div class="text-xs opacity-50 font-mono mt-2">updated @s.UpdatedAt.ToString("yyyy-MM-dd HH:mm") · created @s.CreatedAt.ToString("yyyy-MM-dd")</div>
						</div>
					</a>
				}
			</div>
		</section>
	}
}
