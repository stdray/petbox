@page "/ui/{workspaceKey}/{projectKey}/tasks/node/{nodeId}"
@model PetBox.Web.Pages.ProjectHome.TaskBoardNodeModel
@{
	var node = Model.Detail.Node;
	ViewData["Title"] = string.IsNullOrEmpty(node.Title) ? node.Key : node.Title;

	var nodeKindName = Model.Detail.Kind; // the board's resolved KindName (custom kind verbatim)
	// Make the board kind explicit so its statuses read as a deliberate kind, not "broken" — a
	// single neutral badge for every kind (all kinds are strict data presets now).
	var nodeKindBadgeClass = "badge-neutral";
	var nodeKindTitle = $"{nodeKindName} board — statuses follow the {nodeKindName} workflow";
	// board-terminal-negative-visible: the same invariant the board views enforce — a node in a
	// terminal-cancel status reads as dead on its own detail page too, independent of the status
	// badge's own visibility (StatusBadgeModel.Show, spec-board-status-noise).
	// The spec-board-only scoping (board-ui-review-findings #2) is GONE: live acceptance found a
	// Cancelled work task reading as alive, which the spec node forbids on every board kind.
	var nodeTerminalCancel = Model.Runtime.StatusKindOf(Model.Detail.Kind, node.Status) == PetBox.Tasks.Workflow.StatusKind.TerminalCancel;
	// spec observation-shows-linked-obligation: the `observation_obligation` edge is already part
	// of the exhaustive relations panel below (Model.Detail.Relations — MethodologyRuntime.
	// EffectiveLinkKinds() concatenates ObservationLinkKinds unconditionally, so it resolves
	// regardless of methodology instance), which already shows it "from both sides" per the work
	// card. This just pulls the SAME group forward into a short, noticeable link next to the
	// status badge — only when this node is actually `promoted` (the literal spec condition),
	// not a second, differently-sourced computation.
	var obligationGroup = string.Equals(node.Status, "promoted", StringComparison.OrdinalIgnoreCase)
		? Model.Detail.Relations.FirstOrDefault(g => g.Label.StartsWith("observation_obligation:", StringComparison.Ordinal))
		: null;
}

@* Breadcrumb: tasks / {board} / {ancestors…} / {this node}. The node is addressed by its
   stable id, so the trail is reconstructed from the part_of chain the service returns. *@
<div class="mb-4 flex items-center gap-2 flex-wrap text-sm" data-testid="node-breadcrumb">
	<a href="@Routes.ProjectTasks(Model.WorkspaceKey, Model.ProjectKey)" class="link link-hover opacity-70">tasks</a>
	<span class="opacity-40">/</span>
	<a href="@Routes.ProjectTaskBoard(Model.WorkspaceKey, Model.ProjectKey, Model.Detail.Board)" class="link link-hover opacity-70 font-mono">@Model.Detail.Board</a>
	<span class="badge @nodeKindBadgeClass badge-xs" data-testid="node-board-kind" data-kind="@nodeKindName" title="@nodeKindTitle">@nodeKindName</span>
	@foreach (var a in Model.Detail.Ancestors)
	{
		<span class="opacity-40">/</span>
		<a href="@Routes.TaskBoardNodeBySlug(Model.WorkspaceKey, Model.ProjectKey, Model.Detail.Board, a.Slug)" class="link link-hover opacity-70 font-mono">@(string.IsNullOrEmpty(a.Title) ? a.Slug : a.Title)</a>
	}
	<span class="opacity-40">/</span>
	<span class="font-mono opacity-90" data-testid="node-leaf">@node.Key</span>
	@* Copy-slug: the slug is the identifier you paste into MCP/CLI/other nodes, so make it
	   one click. Reuses the global [data-copy] handler (ts/config.ts, document-level) — the
	   glyph swaps to ✓ on success; textContent-based so no extra wiring. *@
	<button type="button" class="btn btn-ghost btn-xs px-1 leading-none opacity-60 hover:opacity-100" data-copy="@node.Key" data-testid="node-slug-copy" title="Copy slug" aria-label="Copy slug">⧉</button>
</div>

@* Edit lives here on the node page (edit-respects-guards: the POST handlers route through
   ITasksService.UpsertAsync, the same door the MCP path uses). Status change is a plain POST form
   (works without JS); the read/edit toggle + markdown write/preview is wired imperatively by
   ts/nodeEdit.ts (no inline JS), mirroring ts/board.ts. The edit form starts hidden (inline style)
   so it doesn't flash before the script runs. *@
<div class="card bg-base-200 border border-base-300" data-testid="node-detail" data-node-id="@node.NodeId" data-board="@Model.Detail.Board" data-terminal-cancel="@nodeTerminalCancel.ToString().ToLowerInvariant()">
	<div class="card-body p-4">

		@if (Model.Error is not null)
		{
			<div class="alert alert-error text-sm py-2" data-testid="node-edit-error" role="alert">@Model.Error</div>
		}

		<div class="flex items-baseline justify-between gap-2 flex-wrap">
			<h1 class="text-2xl font-semibold @(nodeTerminalCancel ? "line-through opacity-60" : "")" data-testid="node-name">@(string.IsNullOrEmpty(node.Title) ? node.Key : node.Title)</h1>
			@* node-header-action-row-layout: `shrink-0` DROPPED. It pinned this container at
			   max-content, so its own `flex-wrap` could never engage and the row simply ran off the
			   viewport — measured at an 800px window, `Share`/`edit` sat at x≈759..851 with
			   documentElement.scrollWidth 851 > clientWidth 800, i.e. the two buttons were only
			   reachable by horizontal-scrolling the whole page. Without it the container shrinks to
			   the space it has and wraps instead: same 800px window now measures scrollWidth 800,
			   with the Share/edit span dropping to a second right-aligned line, clear of the status
			   select. Wide (1440px) layout is byte-for-byte unchanged. *@
			<div class="flex items-center gap-1 flex-wrap justify-end">
				@if (!string.IsNullOrEmpty(node.Type))
				{
					<span class="badge badge-ghost badge-sm" data-testid="node-type">@node.Type</span>
				}
				@* Opens the "View workflow" modal with this type's FSM graph (ts/workflow-viz.ts). *@
				<button type="button" class="btn btn-ghost btn-xs gap-1" data-testid="workflow-open" data-workflow-type="@node.Type" title="View this type's workflow graph">⤳ workflow</button>
				@* Status badge via the shared partial — the SAME spec-board suppression rule as the
				   board: a non-terminal status on a spec board renders nothing, so the node page and
				   the board agree on this field (ui-spec-status-board-node-mismatch). The status-change
				   form below is unaffected — only the read-only badge is suppressed. *@
				<partial name="_StatusBadge" model="new PetBox.Web.Pages.Shared.StatusBadgeModel(Model.Runtime, Model.Detail.Kind, node.Status)" />
				@* decision-pending-has-no-ui: badge + the ONLY UI door to set/clear the flag — before
				   this form, the owner could read the queue only via an agent (tasks_search
				   decisionPending:) and never mark a card themselves. A plain POST form (works
				   without JS), same door (UpsertAsync via TaskBoardNodeModel.ApplyAsync) every other
				   edit on this page already goes through, so it hits the SAME guards/concurrency
				   check as the MCP path. *@
				@if (node.DecisionPending)
				{
					<span class="badge badge-warning badge-sm" data-testid="node-decision-pending-badge" title="waiting on the owner's decision">⏳ waiting on you</span>
				}
				<form method="post" asp-page-handler="DecisionPending" class="inline-flex items-center" data-testid="node-decision-pending-form">
					<input type="hidden" name="version" value="@node.Version" />
					@* live-verification finding: Razor's runtime attribute writer treats a BARE bool
					   expression as an HTML5 "minimized boolean attribute" for ANY attribute name, not
					   just the curated checked/disabled/readonly/... list — `value="@(someBool)"` renders
					   literal `value="value"` when true and OMITS the attribute entirely when false. That
					   silently broke "mark waiting on me": true rendered as `value="value"` (unparseable,
					   binds to default false) while false rendered as no attribute at all (also binds to
					   default false) — so a `bool` model-bound parameter can NEVER observe true through
					   this attribute. Forcing the value through ToString() changes its static type to
					   string, which turns the special-casing off and lets the real "True"/"False" text
					   reach the wire (the default ModelBinder for `bool` accepts either case). *@
					<input type="hidden" name="pending" value="@((!node.DecisionPending).ToString())" />
					@* live-verification finding (owner, 2026-08-28): this button lacked any visual
					   affordance — plain unhovered `btn-ghost` renders as bare text, indistinguishable
					   from a caption, and the effect is much more noticeable on a multi-word label
					   ("mark waiting on me") than on a short familiar one ("edit"). Reusing the row's
					   ALREADY-established look for a SAME-CATEGORY control — a one-click POST-form
					   submit button (the status-change "→" button just below is the other one) — not
					   inventing a third style: drop `-ghost`, matching that button's visible bordered box
					   in every theme (daisyUI's plain `.btn` is themed, not a new hardcoded colour). *@
					<button type="submit" class="btn btn-xs" data-testid="node-decision-pending-toggle" title="@(node.DecisionPending ? "Clear — no longer waiting on a decision" : "Mark as waiting on the owner's decision")">
						@(node.DecisionPending ? "clear decision flag" : "mark waiting on me")
					</button>
				</form>
				@if (Model.NextStatuses.Count > 0)
				{
					<form method="post" asp-page-handler="Status" class="inline-flex items-center gap-1" data-testid="node-status-form">
						<input type="hidden" name="version" value="@node.Version" />
						@* approval-gate-enforced-visible: a target behind a declared approval gate is
						   MARKED (text suffix + title + data-approval), so "Done" from "Review" no longer
						   reads exactly like "Todo". Marking only — every option stays selectable; the
						   owner is allowed the move, and the service re-validates it on POST. *@
						<select name="status" class="select select-bordered select-xs" data-testid="node-status-select" aria-label="Change status">
							@foreach (var opt in Model.NextStatusOptions)
							{
								@* A null attribute value is OMITTED by Razor — an ungated option carries no
								   empty title/data-approval noise. *@
								<option value="@opt.Slug" title="@(opt.GateTitle.Length == 0 ? null : opt.GateTitle)" data-approval="@(opt.GateMode.Length == 0 ? null : opt.GateMode)">@(opt.Name + opt.GateMarker)</option>
							}
						</select>
						<button type="submit" class="btn btn-xs" data-testid="node-status-submit" title="change status">→</button>
					</form>
				}
				@if (node.Delivery is not null)
				{
					<partial name="_DeliveryBadge" model="new PetBox.Web.Pages.Shared.DeliveryBadgeModel(node.Delivery)" />
				}
				@* observation-ui-distinct-from-task: node.Observation is null on every board except
				   `observations`, so this is a no-op everywhere else. *@
				<partial name="_ObservationRecurrenceBadge" model="new PetBox.Web.Pages.Shared.ObservationSignalModel(node.Observation, Model.WorkspaceKey, Model.ProjectKey)" />
				@* spec observation-shows-linked-obligation: a short, noticeable link next to the
				   status badge — see obligationGroup's own comment above for where it comes from. *@
				@if (obligationGroup is not null && obligationGroup.Links.Count > 0)
				{
					<span class="badge badge-info badge-sm" data-testid="node-observation-obligation-badge" title="promoted — addressed by">
						@foreach (var l in obligationGroup.Links)
						{
							@if (l.NodeId.Length > 0 && l.Status != "missing")
							{
								var href = l is { Board: { Length: > 0 } ob, Slug: { Length: > 0 } os }
									? Routes.TaskBoardNodeBySlug(Model.WorkspaceKey, Model.ProjectKey, ob, os)
									: Routes.TaskBoardNode(Model.WorkspaceKey, Model.ProjectKey, l.NodeId);
								<a href="@href" class="link link-hover font-mono" data-testid="node-observation-obligation-link">→ obligation: @(l.Slug ?? l.NodeId)</a>
							}
							else
							{
								<span data-testid="node-observation-obligation-link">→ obligation: @(l.Slug ?? l.NodeId) · @l.Status</span>
							}
						}
					</span>
				}
				@* node-header-action-row-layout: the status-change form is the KEY action in this row,
				   but `Share` and `edit` sat exactly one `gap-1` away from its "→" submit — the same
				   distance that separates the select from its own button — so all of it read as one
				   group and the key action was lost among the auxiliary ones. Fix is grouping only:
				   the two auxiliary buttons get their own span with a wider left margin (the row's
				   gap-1 + ml-3), which also keeps them together as one unit when the row wraps on a
				   narrow window. The buttons themselves, their labels, testids and behaviour are
				   untouched, and no new visual language is introduced — just spacing. *@
				<span class="inline-flex items-center gap-1 ml-3">
					@* node-share-ui (spec node-share / node-share-scope): opens _NodeShareModal below, which
					   is where project/board/node identity lives — this button only says "a node share,
					   default scope". The scope itself (body / full) is picked in the modal, because it is
					   baked into the minted token and cannot be widened by the reader afterwards. *@
					<button type="button" class="btn btn-ghost btn-xs" data-node-share-open data-scope="node"
						data-testid="node-share-open" title="Create a public link to this node">Share</button>
					<button type="button" class="btn btn-ghost btn-xs" data-testid="node-edit-toggle">edit</button>
				</span>
			</div>
		</div>

		@if (node.Tags.Count > 0)
		{
			<div class="flex flex-wrap gap-1 mt-1" data-testid="node-tags">
				@foreach (var tag in node.Tags)
				{
					<span class="badge badge-xs badge-outline font-mono">@tag</span>
				}
			</div>
		}

		@* Created/updated timestamps (task-card-timestamps): TaskNodeView already carries both off
		   the active revision (board-sort-impl) — no new fetch needed. Same `time.local-time`
		   convention as the board card (_TaskNodeCard.cshtml) — server renders UTC in `datetime`
		   (round-trip "o"), ts/logs.ts's renderLocalTimes pass localizes the visible text on load. *@
		<div class="text-xs opacity-50 mt-1 flex flex-wrap gap-x-3" data-testid="node-timestamps">
			@if (node.CreatedAt is not null)
			{
				<span>created <time class="local-time" datetime="@node.CreatedAt.Value.ToString("o")" data-testid="node-created">@node.CreatedAt.Value.ToString("yyyy-MM-dd HH:mm")</time></span>
			}
			@if (node.UpdatedAt is not null)
			{
				<span>updated <time class="local-time" datetime="@node.UpdatedAt.Value.ToString("o")" data-testid="node-updated">@node.UpdatedAt.Value.ToString("yyyy-MM-dd HH:mm")</time></span>
			}
		</div>

		@* spec node-session-provenance-visible-in-ui: UNCONDITIONAL here, unlike the board card/row/
		   kanban/outline callers (BoardFieldNames.Sessions) — this page has no fields dialog to gate
		   on (board-view-fields is a board-view affordance; a node detail page has always shown
		   everything it knows about ONE node), and the spec explicitly requires this to show "на
		   детальной странице" too. Right next to the timestamps block above: both are "when/who
		   touched this node" provenance. *@
		<partial name="_NodeSessionProvenanceBadge" model="new PetBox.Web.Pages.Shared.NodeSessionProvenanceModel(node.OriginSessionId, node.OriginSessions, Model.WorkspaceKey, Model.ProjectKey)" />

		@* observation-ui-distinct-from-task: standalone, loud banner (spec
		   observation-regression-signalled-on-card) — a no-op when node.Observation has no
		   RecurredAfterFixAt (every non-observation node, and most observation nodes). *@
		<partial name="_ObservationRegressionBanner" model="new PetBox.Web.Pages.Shared.ObservationSignalModel(node.Observation, Model.WorkspaceKey, Model.ProjectKey, Model.ObservationFixedByLink)" />

		@* Edit form (title + body, markdown write/preview). Hidden until ts/nodeEdit.ts shows it.
		   The textarea is the source for both the POST body and the preview render. *@
		<form method="post" asp-page-handler="Edit" class="flex flex-col gap-2 mt-3" data-testid="node-edit-form" style="display:none">
			<input type="hidden" name="version" value="@node.Version" />
			<input type="text" name="title" value="@node.Title" maxlength="200" class="input input-bordered input-sm w-full" placeholder="Title" data-testid="node-edit-title" aria-label="Title" />
			<div role="tablist" class="tabs tabs-bordered text-xs self-start">
				<a role="tab" class="tab tab-active" data-testid="node-edit-write-tab">write</a>
				<a role="tab" class="tab" data-testid="node-edit-preview-tab">preview</a>
			</div>
			<textarea name="body" rows="12" class="textarea textarea-bordered textarea-sm w-full font-mono" placeholder="Body (markdown)" data-testid="node-edit-body" aria-label="Body">@node.Body</textarea>
			@* editor-preview-renders-server-side: the preview is rendered by the SERVER, through the
			   same IMarkdownRenderer as the saved body (?handler=Preview), so what the author sees
			   is byte-for-byte what saving produces. The old second pipeline (ts/markdown.ts —
			   marked + DOMPurify) is gone: it rendered `##` as a bare <h2> with no md-section
			   wrapper and `> [!NOTE]` as an ordinary blockquote holding the literal "[!NOTE]".

			   The trigger is a NON-INPUT element on purpose. `hx-include="closest form"` posts the
			   form's fields — `body` plus its antiforgery token — and a span contributes no value
			   of its own; hanging hx-post on the textarea instead would send `body` TWICE and bind
			   as "draft,draft". The relative `?handler=Preview` keeps whichever address the page
			   was opened by (…/tasks/node/{id} or …/tasks/{board}/{slug}), so the handler's
			   ResolveAsync scopes the preview to this node either way — same trick as the outline's
			   lazy `?handler=NodeBody` fetch.

			   ts/nodeEdit.ts fires `preview-refresh`: immediately when the preview tab is opened,
			   debounced while the author keeps typing. *@
			<span hidden data-testid="node-edit-preview-trigger"
				  hx-post="?handler=Preview"
				  hx-trigger="preview-refresh"
				  hx-include="closest form"
				  hx-target="[data-testid='node-edit-preview']"
				  hx-swap="innerHTML"></span>
			@* Shown by ts/nodeEdit.ts when a preview request fails (offline, or a server error).
			   htmx does not swap on a failed response, so the pane keeps its last good render and
			   this strip says so — the preview never silently presents stale HTML as current. *@
			<div class="alert alert-warning text-xs py-1 px-2" data-testid="node-edit-preview-error" role="status" style="display:none"></div>
			<partial name="_MdBody" model="@(new PetBox.Web.Pages.Shared.MdBodyModel { TestId = "node-edit-preview", ExtraClasses = "border border-base-300 rounded p-3 min-h-24", Style = "display:none", ServerRender = false })" />
			<div class="flex items-center gap-2">
				<button type="submit" class="btn btn-sm btn-primary" data-testid="node-edit-save">Save</button>
				<button type="button" class="btn btn-sm btn-ghost" data-testid="node-edit-cancel">Cancel</button>
			</div>
		</form>

		@* Reader-view content root (reader-view-body-and-comments): the task body AND the comment
		   thread are Readability's two natural top candidates (each sits in its own subtree, both
		   scored up by the "body" keyword in md-body's class) — Readability keeps only ONE winner
		   and drops the other. Wrapping both under ONE semantic <article> makes THIS the winning
		   candidate instead, so everything inside survives extraction together. Editorial chrome
		   (breadcrumb, status-change form, title/body edit form) stays OUTSIDE this root, above —
		   it's noise in reader view. The per-comment reply/edit/delete forms inside the thread
		   don't need special negative-weighting: Readability scores <form> at -3 and always strips
		   their <input>/<textarea>/<button>/<select> children regardless of class, so they fall out
		   on their own without penalizing the surrounding comment text.
		   round 2 (real ideas/memory-store-creation-guard node still dropped the body after round
		   1 — verified, not guessed): this article ALSO now carries data-testid="node-comments",
		   the former identity of _CommentThread.cshtml's own wrapper div, which round 2 deleted to
		   cut the comment thread's ancestor distance to this shared root from 4 levels to 2 (see
		   _CommentThread.cshtml for the full explanation). ts/commentThread.ts's delegated click
		   listener now binds here — harmless for clicks inside node-read-body, since none of the
		   comment-specific selectors it looks for exist there. *@
		<article class="node-reader-content mt-3" data-testid="node-comments">
			@* Read body, no truncation (node-page-full-body). Markdown is rendered to sanitized HTML
			   on the SERVER (_MdBody / IMarkdownRenderer) so browser reader-view can detect real
			   markup; storage/format unchanged. Hidden while editing. *@
			@* Body framed as its own block (border + padding) so the task text reads as distinct
			   content, separated from the meta row above and the relations/comments below. *@
			<div data-testid="node-read-body" class="rv-content">
				@if (!string.IsNullOrEmpty(node.Body))
				{
					<div class="rounded-lg border border-base-300/70 bg-base-100/40 p-4">
						<partial name="_MdBody" model="@(new PetBox.Web.Pages.Shared.MdBodyModel { Body = node.Body, TestId = "node-body", CommitUrlTemplate = Model.CommitUrlTemplate, NodeRefs = Model.NodeRefs, MemoryRefs = Model.MemoryRefs })" />
					</div>
				}
				else
				{
					<p class="text-base opacity-40 italic" data-testid="node-body-empty">(no body)</p>
				}
			</div>

			@if (node.Commits is { Count: > 0 })
			{
				<div class="text-xs opacity-50 font-mono mt-2 flex flex-wrap gap-x-2 gap-y-1" data-testid="node-commits">
					@foreach (var sha in node.Commits)
					{
						var commitUrl = PetBox.Web.Rendering.CommitUrl.For(Model.CommitUrlTemplate, sha);
						if (commitUrl is not null)
						{
							<a href="@commitUrl" target="_blank" rel="noopener" class="link link-hover" data-testid="node-commit-link">@sha</a>
						}
						else
						{
							<span data-testid="node-commit">@sha</span>
						}
					}
				</div>
			}

			@* Exhaustive relation panel (node-relations-panel): every relation kind in both directions
			   — children (part_of down), blocks/blocked by, implements/linked, idea/spec, issue/tasks,
			   supersedes/superseded by, PLUS the neutral trio relates_to/depends_on/mirrors (related
			   by/relates to, depended on by/depends on, mirrored by/mirrors) — computed by the service
			   into Detail.Relations. Only non-empty groups render, in a fixed reading order; each row
			   shows the target's live status. *@
			@foreach (var group in Model.Detail.Relations)
			{
				@if (group.Links.Count > 0)
				{
					<div class="text-sm opacity-80 mt-2 flex flex-wrap items-baseline gap-x-2 gap-y-1" data-testid="node-links" data-relation="@group.Label">
						<span class="opacity-60">@group.Label:</span>
						@foreach (var l in group.Links)
						{
							@if (l.NodeId.Length > 0 && l.Status != "missing")
							{
								@* Canonical slug-URL when the target's board+slug are known (cross-board
								   links carry both); fall back to the opaque nodeId alias otherwise. *@
								var href = l is { Board: { Length: > 0 } b, Slug: { Length: > 0 } s }
									? Routes.TaskBoardNodeBySlug(Model.WorkspaceKey, Model.ProjectKey, b, s)
									: Routes.TaskBoardNode(Model.WorkspaceKey, Model.ProjectKey, l.NodeId);
								<a href="@href" class="link link-hover font-mono" data-testid="node-link">@(l.Slug ?? l.NodeId)<span class="opacity-50"> · @l.Status</span></a>
							}
							else
							{
								<span class="font-mono opacity-50" data-testid="node-link">@(l.Slug ?? l.NodeId) · @l.Status</span>
							}
						}
					</div>
				}
			}

			@* comment-permalink-anchor: the canonical detail-page URL (NOT wherever this partial
			   happens to render — same scheme+host+path idiom as Logs/Index.cshtml's ingestUrl),
			   so a copied comment link always points at the shared-target page even if a future
			   list view starts rendering this partial too (ShowAddForm: false, per the doc comment
			   in _CommentThread.cshtml). *@
			@{ var nodeUrl = $"{ViewContext.HttpContext.Request.Scheme}://{ViewContext.HttpContext.Request.Host}{Routes.TaskBoardNodeBySlug(Model.WorkspaceKey, Model.ProjectKey, Model.Detail.Board, node.Key)}"; }
			<partial name="_CommentThread" model="@(new PetBox.Web.Pages.Shared.CommentThreadModel(Model.Thread, node.NodeId, Model.CommitUrlTemplate, Model.NodeRefs, MemoryRefs: Model.MemoryRefs, NodeUrl: nodeUrl))" />
		</article>
	</div>
</div>

@if (Model.WorkflowJson is not null)
{
	<partial name="_WorkflowModal" model="Model.WorkflowJson" />
}

@* node-share-ui: ONE dialog per page, serving both the header Share button above and every
   per-comment share button inside the thread partial. Deliberately outside the reader-view
   <article> — it is editorial chrome, like the workflow modal. *@
<partial name="_NodeShareModal" model="@(new PetBox.Web.Pages.Shared.NodeShareModalModel(Model.ProjectKey, Model.Detail.Board, node.NodeId))" />
