@model PetBox.Web.Pages.Shared.NodeShareModalModel
@* Share modal for ONE task node and its discussion (spec `node-share`, `node-share-scope`; card
   `node-share-ui`). Shaped after the log-query share modal (Logs/Index.cshtml) so the two read as
   the same affordance, but it is its OWN dialog with its own id: the two mint through different
   endpoints and the node one carries a scope the query one has no concept of.

   The dialog — not the buttons — carries project/board/nodeId. Every opener on this page (the
   header Share button AND every per-comment share button inside _CommentThread) then needs only
   the part that differs between them (scope, and the comment id), instead of repeating the node's
   identity on every comment row. ts/nodeShare.ts reads the identity off this element.

   Rendered ONLY by the node detail page. The public share page renders _CommentThread with
   ShowAddForm:false and no modal at all — nodeShare.ts's open handler is a no-op without this
   element, so a stray opener could not mint anything there even if one leaked in. *@
<dialog id="node-share-modal" class="modal"
	data-testid="node-share-modal"
	data-project="@Model.ProjectKey"
	data-board="@Model.Board"
	data-node-id="@Model.NodeId">
	<div class="modal-box max-w-md">
		<h3 id="node-share-title" class="text-lg font-semibold mb-1" data-testid="node-share-title">Share this node</h3>
		<p class="text-xs opacity-70 mb-3">
			The link carries an opaque token. Anyone holding it can read what you picked below —
			without signing in — until you revoke it.
		</p>

		@* Scope is chosen at MINT time and baked into the token (spec node-share-scope): the reader
		   cannot widen it later. Switching here therefore mints a DIFFERENT link rather than
		   re-pointing the one on screen — nodeShare.ts re-creates on change. Hidden entirely when
		   the modal was opened from a single comment (the comment IS the scope). *@
		<div class="flex flex-col gap-1 mb-3" data-testid="node-share-scope-choice">
			<label class="flex items-center gap-2 cursor-pointer">
				<input type="radio" name="node-share-scope" value="body" class="radio radio-sm" checked
					data-testid="node-share-scope-body" />
				<span class="text-sm">Body only</span>
			</label>
			<label class="flex items-center gap-2 cursor-pointer">
				<input type="radio" name="node-share-scope" value="full" class="radio radio-sm"
					data-testid="node-share-scope-full" />
				<span class="text-sm">Everything, including the discussion</span>
			</label>
		</div>

		<div class="join w-full">
			<input id="node-share-url" type="text" readonly data-testid="node-share-url"
				class="input input-sm input-bordered join-item w-full font-mono text-xs" />
			<button type="button" class="btn btn-sm join-item" data-node-share-copy
				data-testid="node-share-copy">Copy</button>
		</div>

		@* Says out loud what "no ttlMinutes" means. A link with no expiry is the default here, so
		   the strip states it rather than sitting blank and letting the reader assume a timer. *@
		<p id="node-share-expiry" data-testid="node-share-expiry" class="text-xs opacity-60 mt-2"></p>

		@* Revoke is the ONLY withdrawal mechanism for an indefinite link, so it ships with the modal
		   rather than as a later addition (the log modal had to learn this the hard way — see
		   share-link-revocation-finish). Starts disabled; nodeShare.ts enables it once a token
		   actually exists to revoke, so it can never fire against an empty or failed modal. *@
		<div class="mt-3 flex items-center gap-2">
			<button type="button" class="btn btn-sm btn-error btn-outline" data-node-share-revoke
				data-testid="node-share-revoke" disabled
				title="Revoke this link — anyone holding it loses access immediately">Revoke</button>
			<span id="node-share-revoke-status" data-testid="node-share-revoke-status" class="text-xs opacity-70"></span>
			<form method="dialog" class="ml-auto"><button class="btn btn-sm btn-ghost">Close</button></form>
		</div>
	</div>
	<form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>
