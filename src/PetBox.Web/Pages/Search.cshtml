@page "/ui/search"
@model PetBox.Web.Pages.SearchModel
@using PetBox.Web.Pages.Shared
@using PetBox.Web.Search
@{
	ViewData["Title"] = "Search";
}

<h1 class="text-2xl font-semibold mb-4" data-testid="search-title">Search</h1>

<form method="get" action="/ui/search" class="mb-6 flex gap-2 max-w-xl" data-testid="search-page-form">
	<input type="text" name="q" value="@Model.Q" placeholder="Slug, NodeId, or search text…"
		class="input input-bordered flex-1" data-testid="search-page-input" autofocus />
	<button type="submit" class="btn btn-primary" data-testid="search-page-submit">Search</button>
</form>

@if (string.IsNullOrWhiteSpace(Model.Q))
{
	<div class="opacity-60" data-testid="search-empty-state">
		Paste a task slug or NodeId, or type a search phrase — results span every workspace and project you can access.
	</div>
	return;
}

@if (Model.Hits.Count == 0)
{
	<div class="alert" data-testid="search-no-results">No tasks found for "@Model.Q".</div>
	return;
}

<div class="text-sm opacity-60 mb-3" data-testid="search-result-count">
	@Model.Hits.Count result@(Model.Hits.Count == 1 ? "" : "s")
</div>

@if (Model.AtLocatorCeiling)
{
	@* ui-search-locator-honest-boundary: state the cap as a known fact, never a hedge — the merge
	   enforces MaxResults exactly (SearchModel.AtLocatorCeiling), so reaching it is certain, not a
	   guess. Names both narrowing actions the spec calls out: paste the exact slug/NodeId (the
	   identifier leg has no cap), or step down into one project's own search. *@
	<div class="alert alert-warning mb-3 text-sm" data-testid="search-locator-ceiling">
		Showing @CrossScopeTaskSearchService.MaxResults matches — this locator's ceiling across every project you can access, not the end of the data. For the full picture: paste the exact slug or NodeId, or narrow to a search within one project.
	</div>
}

@{ var filterBarShown = false; }

@if (Model.ExactRows.Count > 0)
{
	@* ui-search-group-by-project item 3: an exact-identifier hit (a pasted slug/NodeId) stays FIRST
	   and UNGROUPED — this page's own file-header estimate is ~98% of real queries, so that path
	   must stay instant, never buried inside a collapsed per-project section. Reuse of the SAME
	   table component TaskBoard's table view mode renders (_TaskTable.cshtml,
	   board-view-mode-framework) — with the workspace/project/board columns switched on, since a
	   result's location isn't implicit on this page the way it is inside a single board. *@
	<partial name="_TaskTable" model="new TaskTableModel(Model.ExactRows, ShowScopeColumns: true, ShowFilterBar: true)" />
	filterBarShown = true;
}

@foreach (var group in Model.Groups)
{
	@* ui-search-group-by-project: the true order is project-by-project, not a cross-project
	   relevance ranking (CrossScopeTaskSearchService.cs:126-133) — this makes that order VISIBLE as
	   a collapsible section per project, open by default so the grouping never hides a result the
	   flat list would have shown. The header names where the section's rows live (workspace +
	   project) and how many were found; "Search in this project" is the bridge to the full search
	   this cross-scope screen deliberately never grows (spec
	   cross-scope-search-is-an-identifier-locator). *@
	<details open class="border border-base-300 rounded-box mb-2" data-testid="search-project-group" data-workspace="@group.Workspace" data-project="@group.ProjectKey">
		<summary class="cursor-pointer flex items-center gap-2 px-3 py-2 font-medium" data-testid="search-project-group-header">
			<span class="font-mono text-sm" data-testid="search-project-group-name">@group.Workspace / @group.ProjectKey</span>
			<span class="badge badge-ghost badge-sm" data-testid="search-project-group-count">@group.Rows.Count</span>
		</summary>
		<div class="px-3 pb-3">
			<a href="@group.SearchInProjectUrl" class="btn btn-xs btn-outline mb-2" data-testid="search-in-project-link">Search in this project</a>
			<partial name="_TaskTable" model="new TaskTableModel(group.Rows, ShowScopeColumns: true, ShowFilterBar: !filterBarShown)" />
		</div>
	</details>
	filterBarShown = true;
}
