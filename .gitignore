# .NET
[Bb]in/
# petbox-wire npm launcher lives in bin/ — not a .NET build dir; keep it tracked so the
# published package (and a clean CI checkout) carries it.
!src/clients-ts/petbox-wire/bin/
!src/clients-ts/petbox-wire/bin/**
[Oo]bj/
[Oo]ut/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
*.userprefs
*.pidb
*.svclog
*.log
.vs/
.vscode/
*.rsuser
*.sln.docstates
*.pdb
project.lock.json
project.fragment.lock.json
artifacts/

# Test results
[Tt]est[Rr]esult*/
coverage/
*.coverage
*.coveragexml
TestResults/

# BenchmarkDotNet artifacts
BenchmarkDotNet.Artifacts/

# Cake (tool restore) — but keep the tracked KqlBench research harness and the
# session-usage token-reporting tool
tools/*
!tools/KqlBench/
tools/KqlBench/bench-results.jsonl
!tools/session-usage/
.cake/

# Python (agent/ deploy tool)
__pycache__/
*.pyc

# NuGet
*.nupkg
*.snupkg
packages/
!packages/build/
.nuget/

# The wiring kit's copy of the canonical agent roster (src/common/default-agents.json).
# GENERATED by src/clients-ts/petbox-wire/scripts/sync-default-agents.mjs on every test /
# typecheck / pack, and untracked ON PURPOSE: a tracked copy would be a second editable source of
# the same document, which is exactly the drift the single canonical file removes. npm's `files`
# allowlist wins over ignore rules, so it still ships inside the published tarball (the kit's
# offline fallback must be physically present) — verified with `npm pack`.
src/clients-ts/petbox-wire/src/default-agents.json

# Frontend
node_modules/
dist/
.cache/

# Frontend build outputs (bun + tailwind)
**/wwwroot/js/**
**/wwwroot/css/**
!**/wwwroot/js/.gitkeep
!**/wwwroot/css/.gitkeep

# Bun
bun.lockb.backup

