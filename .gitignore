# Claude Code (personal)
.claude/*
# ...except any project-native skill whose content is canon and should be tracked/distributed
# (none currently — every skill under .claude/skills is now kit-delivered from
# src/clients-ts/petbox-wire templates and stays untracked). Structure kept for the next one:
# un-ignore each level explicitly, since git will not descend into an ignored dir.
!.claude/skills/
.claude/skills/*

# opencode (personal)
.opencode/
.agents/

# Playwright MCP artifacts
.playwright-mcp/
tmp/
.tmp/

# Auto-generated by dotnet run build.cs (Cake.Sdk file-based)
/build.csproj
.factory
.playwright-cli

