# Copy to `secrets.local.env` (gitignored) and fill in real values, then run:
#   scripts/set-gh-secrets.sh
# Values are pushed to GitHub Actions secrets via `gh secret set`.

# restic repository password — GENERATE with `openssl rand -base64 48`, store in
# KeePass. Losing it makes every offsite backup unrecoverable.
RESTIC_PASSWORD=

# Cloudflare R2 (compact backup, data minus logs)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=petbox

# EGRESS PROXY — a fallback, never an order. Empty = direct connections only.
# The full leg's endpoint (firsts3.ru) is filtered for this host's prefix: TCP times out while
# ICMP answers, so the direct route can be dead for the full leg while R2 is perfectly reachable.
# deploy/backup/egress.sh probes the direct route FIRST and sets this proxy ONLY for a leg whose
# direct probe failed; the other leg stays direct. HTTPS_PROXY must NOT be set in compose — that
# would apply to both legs.
# Format: http://<user>:<pass>@<host>:<port>  (SOCKS is not used by restic's S3 client here).
# Changing the proxy or its password means updating this AND the GH secret.
BACKUP_HTTPS_PROXY=

# FirstVDS S3 (full backup, incl. logs)
FVDS_ACCESS_KEY_ID=
FVDS_SECRET_ACCESS_KEY=
FVDS_S3_ENDPOINT=https://firsts3.ru   # was s3.firstvds.ru (moved 2026-08, old domain NXDOMAIN)
FVDS_BUCKET=petbox

# Optional: failure alert + success heartbeat for the backup sidecar. All three
# are no-ops if left blank — leave them empty to skip alerting entirely.

# Telegram bot token (from @BotFather) used to send a "backup failed"/"recovered" message.
TELEGRAM_BOT_TOKEN=
# Telegram chat/user id the bot messages (e.g. your own numeric user id from @userinfobot).
TELEGRAM_CHAT_ID=
# healthchecks.io (or similar) ping URL hit once per successful backup run (dead-man's-switch).
HEALTHCHECK_URL=
